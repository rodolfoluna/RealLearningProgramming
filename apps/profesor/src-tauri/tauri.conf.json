{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LP Profesor",
  "version": "0.2.1",
  "identifier": "mx.reallearningprogramming.profesor",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. preparar && pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm --dir ../.. preparar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LP Profesor — Revisión de entregas",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost rlpentrada: http://rlpentrada.localhost",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
